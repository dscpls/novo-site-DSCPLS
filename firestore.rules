rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == "henrikingames@gmail.com";
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidDiaryEntry(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt']) && data.keys().size() == 3
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 50000
        && data.createdAt is timestamp;
    }

    match /diario/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      
      allow create: if isAdmin() 
        && isValidId(entryId)
        && isValidDiaryEntry(incoming())
        && incoming().createdAt == request.time;
        
      allow update: if isAdmin()
        && isValidId(entryId)
        && isValidDiaryEntry(incoming());
        
      allow delete: if isAdmin() && isValidId(entryId);
    }
  }
}
