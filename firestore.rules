rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidDiaryEntry(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt']) && data.keys().size() == 3
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 50000
        && data.createdAt is timestamp;
    }

    // Allow newsletter subscriptions
    match /newsletter_subs/{subId} {
      allow create: if true;
      allow read, update, delete: if true; // Used by Admin panel
    }
    
    // We used 'newsletter' previously, keep it open for backward compatibility testing or future-proofing
    match /newsletter/{subId} {
      allow create: if true;
      allow read, update, delete: if true; // Used by Admin panel
    }

    match /diario/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      
      allow create: if isValidId(entryId)
        && isValidDiaryEntry(incoming()); // Relaxed timestamp exactness for offline support in custom admin
        
      allow update: if isValidId(entryId)
        && isValidDiaryEntry(incoming());
        
      allow delete: if isValidId(entryId);
    }
  }
}
